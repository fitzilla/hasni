---
import ServicePage from '../layouts/ServicePage.astro';
---

<ServicePage
  slug="accounting-software-training"
  title="Accounting software training"
  eyebrow="Service 08"
  lead="Want to automate your processes? Fed up with mountains of invoices and receipts? We'll meet with you and advise on the best software for your business."
  description="Advice on choosing accounting software, installation, training, support and migrating to a new system."
  asideTitle="Not sure which software to use?"
  emailSubject="Accounting software training"
>
  <section aria-labelledby="help-heading">
    <h2 id="help-heading" class="h3">How we help</h2>
    <ol class="steps">
      <li>
        <span class="badge" aria-hidden="true">01</span>
        <div>
          <h3>Choosing software</h3>
          <p>Our accountants and business advisors meet with you and advise on what's best for your business needs.</p>
        </div>
      </li>
      <li>
        <span class="badge" aria-hidden="true">02</span>
        <div>
          <h3>Set-up and support</h3>
          <p>
            With a wealth of experience in accounting systems, we can oversee installation and profile administration,
            and provide in-depth support and troubleshooting where needed.
          </p>
        </div>
      </li>
      <li>
        <span class="badge" aria-hidden="true">03</span>
        <div>
          <h3>Switching systems</h3>
          <p>
            Considering a change? We'll report on your best options to improve your business processes, and manage the
            migration with limited impact on your daily work.
          </p>
        </div>
      </li>
    </ol>
  </section>
</ServicePage>
