---
import ServicePage from '../layouts/ServicePage.astro';
---

<ServicePage
  slug="tax-returns"
  title="Tax returns"
  eyebrow="Service 03"
  lead="Tax season can be overwhelming. Keeping track of deadlines, expenses and forms is complicated — so put your tax return in the hands of our accountants."
  description="Self-assessment and corporation tax returns for individuals, sole traders, partnerships and limited companies in Belfast and Northern Ireland."
  asideTitle="Talk to us about your tax return"
  emailSubject="Tax returns"
>
  <section class="prose" aria-labelledby="tax-heading">
    <h2 id="tax-heading" class="h3">From self-assessment to corporation tax</h2>
    <p>
      We support individuals, sole traders, partnerships and limited companies in preparing and filing their tax
      returns — from individual self-assessment to company corporation tax. We listen to your needs and situation, so
      your tax return is taken care of with as little stress as possible.
    </p>
    <ul class="chips" aria-label="Who we help">
      <li class="chip">Individuals</li>
      <li class="chip">Sole traders</li>
      <li class="chip">Partnerships</li>
      <li class="chip">Limited companies</li>
    </ul>
  </section>
</ServicePage>
