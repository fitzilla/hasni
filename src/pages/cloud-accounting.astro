---
import ServicePage from '../layouts/ServicePage.astro';

const benefits = [
  'We can help with your bookkeeping from our office, a little or a lot, depending on how comfortable you are with the software.',
  'We have our own login, so we can advise on any issues over the phone.',
  'We can focus on tax planning and business growth strategies.',
  'You get real-time information on how your business is performing.',
  'You can focus on the core areas of your business.',
];
---

<ServicePage
  slug="cloud-accounting"
  title="Cloud accounting"
  eyebrow="Cloud accounting"
  lead="Times are changing. Like the weekly food shop, more and more people are managing their company's finances online with cloud accounting software."
  description="Cloud accounting support with Sage, QuickBooks and Xero, with remote bookkeeping help and real-time figures."
  asideTitle="Get set up online"
  asideSub="Give us a call to see if we can help you set up an online accounting package."
  emailSubject="Cloud accounting"
  inServices={false}
  tone="teal"
  relatedLabel="Our services"
>
  <ul class="chips" slot="hero" aria-label="Software we work with">
    <li class="chip chip--white">Sage</li>
    <li class="chip chip--white">QuickBooks</li>
    <li class="chip chip--white">Xero</li>
  </ul>

  <section class="prose">
    <p>
      Our team has experience of cloud-based systems including Sage, QuickBooks and Xero, and we're happy to work with
      you on whichever system you prefer.
    </p>
  </section>

  <section aria-labelledby="why-heading">
    <h2 id="why-heading" class="h3">Why go online?</h2>
    <ul class="dot-list">
      {benefits.map((b) => <li>{b}</li>)}
    </ul>
  </section>
</ServicePage>
