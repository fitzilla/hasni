---
import ServicePage from '../layouts/ServicePage.astro';

const items = [
  'Registration with Companies House',
  'Paperwork for the appointment, changes and termination of directors',
  'Statutory filings and annual confirmation statements',
  'Share allocations and stock transfers',
];
---

<ServicePage
  slug="company-secretarial"
  title="Company secretarial"
  eyebrow="Service 07"
  lead="In-house company secretarial services are costly, and often unnecessary. We'll build you a custom-made package instead."
  description="Company secretarial services: Companies House registration, director changes, statutory filings, confirmation statements and share transfers."
  asideTitle="Stay on top of company admin"
  emailSubject="Company secretarial"
>
  <section aria-labelledby="handle-heading">
    <h2 id="handle-heading" class="h3">What we handle</h2>
    <ul class="dot-list">
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="prose" aria-labelledby="joined-heading">
    <h2 id="joined-heading" class="h3">Joined up with your accounts</h2>
    <p>
      Our company secretarial services can be blended with a custom-built approach to your bookkeeping and accounts, so
      you stay compliant with your filing requirements.
    </p>
  </section>

  <section class="callout" aria-labelledby="foreign-heading">
    <h2 id="foreign-heading">Does this sound foreign to you?</h2>
    <p>
      Don't know if it applies? Don't worry — get in touch and our approachable staff will talk you through what it
      all means and how we can help.
    </p>
  </section>
</ServicePage>
